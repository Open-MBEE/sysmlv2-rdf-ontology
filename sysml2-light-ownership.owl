    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/SysML#Element_ownedElement">
        <rdfs:label>ownedElement</rdfs:label>
        <rdfs:comment>The Elements owned by this Element, derived as the ownedRelatedElements of the ownedRelationships of this Element.</rdfs:comment>
        <rdfs:domain rdf:resource="https://www.omg.org/spec/SysML#Element" />
        <rdfs:range rdf:resource="https://www.omg.org/spec/SysML#Element" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/SysML#Element_ownedRelationship">
        <rdfs:label>ownedRelationship</rdfs:label>
        <rdfs:comment>The Relationships for which this Element is the owningRelatedElement.</rdfs:comment>
        <rdfs:domain rdf:resource="https://www.omg.org/spec/SysML#Element" />
        <rdfs:range rdf:resource="https://www.omg.org/spec/SysML#Relationship" />
        <owl:inverseOf rdf:resource="https://www.omg.org/spec/SysML#Relationship_owningRelatedElement" />
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
