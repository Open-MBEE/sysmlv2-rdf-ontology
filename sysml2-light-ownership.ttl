    rdfs:subPropertyOf :Definition_ownedAction .

:Definition_ownedTransition
    a owl:ObjectProperty ;
    rdfs:label "ownedTransition" ;
    rdfs:comment "The TransitionUsages that are ownedUsages of this Definition." ;
    rdfs:domain :Definition ;
