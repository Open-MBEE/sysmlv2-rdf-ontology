    rdfs:range :Type ;
    rdfs:subPropertyOf :Disjoining_typeDisjoined ;
    rdfs:subPropertyOf :Relationship_owningRelatedElement ;
    a owl:FunctionalProperty .

:Element_ownedAnnotation
    a owl:ObjectProperty ;
    rdfs:label "ownedAnnotation" ;
    rdfs:comment "The ownedRelationships of this Element that are Annotations, for which this Element is the annotatedElement." ;
    rdfs:domain :Element ;
    rdfs:range :Annotation ;
    owl:inverseOf :Annotation_owningAnnotatedElement ;
    a owl:FunctionalProperty .

:Element_ownedElement
    a owl:ObjectProperty ;
    rdfs:label "ownedElement" ;
    rdfs:comment "The Elements owned by this Element, derived as the ownedRelatedElements of the ownedRelationships of this Element." ;
    rdfs:domain :Element ;
    rdfs:range :Element .

:Element_ownedRelationship
    a owl:ObjectProperty ;
    rdfs:label "ownedRelationship" ;
    rdfs:comment "The Relationships for which this Element is the owningRelatedElement." ;
    rdfs:domain :Element ;
    rdfs:range :Relationship ;
    owl:inverseOf :Relationship_owningRelatedElement ;
    a owl:FunctionalProperty .

:Element_owner
    a owl:ObjectProperty ;
    rdfs:label "owner" ;
    rdfs:comment "The owner of this Element, derived as the owningRelatedElement of the owningRelationship of this Element, if any." ;
    rdfs:domain :Element ;
    rdfs:range :Element ;
    owl:inverseOf :Element_ownedElement .

:Element_owningMembership
    a owl:ObjectProperty ;
    rdfs:label "owningMembership" ;
    rdfs:comment "The owningRelationship of this Element, if that Relationship is a Membership." ;
    rdfs:domain :Element ;
    rdfs:range :OwningMembership ;
    owl:inverseOf :OwningMembership_ownedMemberElement ;
    a owl:FunctionalProperty .

:Element_owningNamespace
    a owl:ObjectProperty ;
    rdfs:label "owningNamespace" ;
    rdfs:comment "The Namespace that owns this Element, which is the membershipOwningNamespace of the owningMembership of this Element, if any." ;
    rdfs:domain :Element ;
    rdfs:range :Namespace ;
    owl:inverseOf :Namespace_ownedMember .

:Element_owningRelationship
    a owl:ObjectProperty ;
    rdfs:label "owningRelationship" ;
    rdfs:comment "The Relationship for which this Element is an ownedRelatedElement, if any." ;
    rdfs:domain :Element ;
    rdfs:range :Relationship ;
    owl:inverseOf :Relationship_ownedRelatedElement .

:FeatureInverting_owningFeature
    a owl:ObjectProperty ;
    rdfs:label "owningFeature" ;
    rdfs:comment "A featureInverted that is also the owningRelatedElement of this FeatureInverting." ;
    rdfs:domain :FeatureInverting ;
    rdfs:range :Feature ;
    rdfs:subPropertyOf :FeatureInverting_featureInverted ;
    rdfs:subPropertyOf :Relationship_owningRelatedElement ;
    a owl:FunctionalProperty .

:FeatureMembership_ownedMemberFeature
    a owl:ObjectProperty ;
    rdfs:label "ownedMemberFeature" ;
    rdfs:comment "The Feature that this FeatureMembership relates to its owningType, making it an ownedFeature of the owningType." ;
    rdfs:domain :FeatureMembership ;
    rdfs:range :Feature ;
    rdfs:subPropertyOf :Featuring_feature ;
    rdfs:subPropertyOf :OwningMembership_ownedMemberElement ;
    a owl:FunctionalProperty .

:FeatureMembership_owningType
    a owl:ObjectProperty ;
    rdfs:label "owningType" ;
    rdfs:comment "The Type that owns this FeatureMembership." ;
    rdfs:domain :FeatureMembership ;
    rdfs:range :Type ;
    rdfs:subPropertyOf :Featuring_type ;
    rdfs:subPropertyOf :Membership_membershipOwningNamespace ;
    a owl:FunctionalProperty .

:FeatureTyping_owningFeature
    a owl:ObjectProperty ;
    rdfs:label "owningFeature" ;
    rdfs:comment "A typedFeature that is also the owningRelatedElement of this FeatureTyping." ;
    rdfs:domain :FeatureTyping ;
    rdfs:range :Feature ;
    rdfs:subPropertyOf :FeatureTyping_typedFeature ;
    rdfs:subPropertyOf :Specialization_owningType ;
    a owl:FunctionalProperty .

:Feature_ownedFeatureChaining
    a owl:ObjectProperty ;
    rdfs:label "ownedFeatureChaining" ;
    rdfs:comment "The ownedRelationships of this Feature that are FeatureChainings, for which the Feature will be the featureChained." ;
    rdfs:domain :Feature ;
    rdfs:range :FeatureChaining ;
    owl:inverseOf :FeatureChaining_featureChained ;
    a owl:FunctionalProperty .

:Feature_ownedFeatureInverting
    a owl:ObjectProperty ;
    rdfs:label "ownedFeatureInverting" ;
    rdfs:comment "The ownedRelationships of this Feature that are FeatureInvertings and for which the Feature is the featureInverted." ;
    rdfs:domain :Feature ;
    rdfs:range :FeatureInverting ;
    owl:inverseOf :FeatureInverting_owningFeature ;
    a owl:FunctionalProperty .

:Feature_ownedRedefinition
    a owl:ObjectProperty ;
    rdfs:label "ownedRedefinition" ;
    rdfs:comment "The ownedSubsettings of this Feature that are Redefinitions, for which the Feature is the redefiningFeature." ;
    rdfs:domain :Feature ;
    rdfs:range :Redefinition ;
    rdfs:subPropertyOf :Feature_ownedSubsetting .

:Feature_ownedReferenceSubsetting
    a owl:ObjectProperty ;
    rdfs:label "ownedReferenceSubsetting" ;
    rdfs:comment "The one ownedSubsetting of this Feature, if any, that is a ReferenceSubsetting, for which the Feature is the referencingFeature." ;
    rdfs:domain :Feature ;
    rdfs:range :ReferenceSubsetting ;
    owl:inverseOf :ReferenceSubsetting_referencingFeature ;
    a owl:FunctionalProperty .

:Feature_ownedSubsetting
    a owl:ObjectProperty ;
    rdfs:label "ownedSubsetting" ;
    rdfs:comment "The ownedSpecializations of this Feature that are Subsettings, for which the Feature is the subsettingFeature." ;
    rdfs:domain :Feature ;
    rdfs:range :Subsetting ;
    owl:inverseOf :Subsetting_owningFeature ;
    a owl:FunctionalProperty .

:Feature_ownedTypeFeaturing
    a owl:ObjectProperty ;
    rdfs:label "ownedTypeFeaturing" ;
    rdfs:comment "The ownedRelationships of this Feature that are TypeFeaturings and for which the Feature is the featureOfType." ;
    rdfs:domain :Feature ;
    rdfs:range :TypeFeaturing ;
    owl:inverseOf :TypeFeaturing_owningFeatureOfType ;
    a owl:FunctionalProperty .

:Feature_ownedTyping
    a owl:ObjectProperty ;
    rdfs:label "ownedTyping" ;
    rdfs:comment "The ownedSpecializations of this Feature that are FeatureTypings, for which the Feature is the typedFeature." ;
    rdfs:domain :Feature ;
    rdfs:range :FeatureTyping ;
    owl:inverseOf :FeatureTyping_owningFeature ;
    a owl:FunctionalProperty .

:Feature_owningFeatureMembership
    a owl:ObjectProperty ;
    rdfs:label "owningFeatureMembership" ;
    rdfs:comment "The FeatureMembership that owns this Feature as an ownedMemberFeature, determining its owningType." ;
    rdfs:domain :Feature ;
    rdfs:range :FeatureMembership ;
    owl:inverseOf :FeatureMembership_ownedMemberFeature ;
    a owl:FunctionalProperty .

:Feature_owningType
    a owl:ObjectProperty ;
    rdfs:label "owningType" ;
    rdfs:comment "The Type that is the owningType of the owningFeatureMembership of this Feature." ;
    rdfs:domain :Feature ;
    rdfs:range :Type ;
    rdfs:subPropertyOf :Feature_featuringType ;
    owl:inverseOf :Type_ownedFeature .

:FramedConcernMembership_ownedConcern
    a owl:ObjectProperty ;
    rdfs:label "ownedConcern" ;
    rdfs:comment "The ConcernUsage that is the ownedConstraint of this FramedConcernMembership." ;
    rdfs:domain :FramedConcernMembership ;
    rdfs:range :ConcernUsage ;
    rdfs:subPropertyOf :RequirementConstraintMembership_ownedConstraint ;
    a owl:FunctionalProperty .

:Namespace_ownedImport
    a owl:ObjectProperty ;
    rdfs:label "ownedImport" ;
    rdfs:comment "The ownedRelationships of this Namespace that are Imports, for which the Namespace is the importOwningNamespace." ;
    rdfs:domain :Namespace ;
    rdfs:range :Import ;
    owl:inverseOf :Import_importOwningNamespace ;
    a owl:FunctionalProperty .

:Namespace_ownedMember
    a owl:ObjectProperty ;
    rdfs:label "ownedMember" ;
    rdfs:comment "The owned members of this Namespace, which are the ownedMemberElements of the ownedMemberships of the Namespace." ;
    rdfs:domain :Namespace ;
    rdfs:range :Element ;
    rdfs:subPropertyOf :Namespace_member .

:Namespace_ownedMembership
    a owl:ObjectProperty ;
    rdfs:label "ownedMembership" ;
    rdfs:comment "The ownedRelationships of this Namespace that are Memberships, for which the Namespace is the membershipOwningNamespace." ;
    rdfs:domain :Namespace ;
    rdfs:range :Membership ;
    rdfs:subPropertyOf :Namespace_membership ;
    owl:inverseOf :Membership_membershipOwningNamespace ;
    a owl:FunctionalProperty .

:ObjectiveMembership_ownedObjectiveRequirement
    a owl:ObjectProperty ;
    rdfs:label "ownedObjectiveRequirement" ;
    rdfs:comment "The RequirementUsage that is the ownedMemberFeature of this RequirementUsage." ;
    rdfs:domain :ObjectiveMembership ;
    rdfs:range :RequirementUsage ;
    rdfs:subPropertyOf :FeatureMembership_ownedMemberFeature ;
    a owl:FunctionalProperty .

:OwningMembership_ownedMemberElement
    a owl:ObjectProperty ;
    rdfs:label "ownedMemberElement" ;
    rdfs:comment "The Element that becomes an ownedMember of the membershipOwningNamespace due to this OwningMembership." ;
    rdfs:domain :OwningMembership ;
    rdfs:range :Element ;
    rdfs:subPropertyOf :Membership_memberElement ;
    rdfs:subPropertyOf :Relationship_ownedRelatedElement ;
    a owl:FunctionalProperty .

:ParameterMembership_ownedMemberParameter
    a owl:ObjectProperty ;
    rdfs:label "ownedMemberParameter" ;
    rdfs:comment "The Feature that is identified as a parameter by this ParameterMembership." ;
    rdfs:domain :ParameterMembership ;
    rdfs:range :Feature ;
    rdfs:subPropertyOf :FeatureMembership_ownedMemberFeature ;
    a owl:FunctionalProperty .

:Relationship_ownedRelatedElement
    a owl:ObjectProperty ;
    rdfs:label "ownedRelatedElement" ;
    rdfs:comment "The relatedElements of this Relationship that are owned by the Relationship." ;
    rdfs:domain :Relationship ;
    rdfs:range :Element ;
    rdfs:subPropertyOf :Relationship_relatedElement .

:Relationship_owningRelatedElement
    a owl:ObjectProperty ;
    rdfs:label "owningRelatedElement" ;
    rdfs:comment "The relatedElement of this Relationship that owns the Relationship, if any." ;
    rdfs:domain :Relationship ;
    rdfs:range :Element ;
    rdfs:subPropertyOf :Relationship_relatedElement ;
    a owl:FunctionalProperty .

:RequirementConstraintMembership_ownedConstraint
    a owl:ObjectProperty ;
    rdfs:label "ownedConstraint" ;
    rdfs:comment "The ConstraintUsage that is the ownedMemberFeature of this RequirementConstraintMembership." ;
    rdfs:domain :RequirementConstraintMembership ;
    rdfs:range :ConstraintUsage ;
    rdfs:subPropertyOf :FeatureMembership_ownedMemberFeature ;
    a owl:FunctionalProperty .

:RequirementVerificationMembership_ownedRequirement
    a owl:ObjectProperty ;
    rdfs:label "ownedRequirement" ;
    rdfs:comment "The owned RequirementUsage that acts as the ownedConstraint for this RequirementVerificationMembership. This will either be the verifiedRequirement, or it will subset the verifiedRequirement." ;
    rdfs:domain :RequirementVerificationMembership ;
    rdfs:range :RequirementUsage ;
    rdfs:subPropertyOf :RequirementConstraintMembership_ownedConstraint ;
    a owl:FunctionalProperty .

:ResultExpressionMembership_ownedResultExpression
    a owl:ObjectProperty ;
    rdfs:label "ownedResultExpression" ;
    rdfs:comment "The Expression that provides the result for the owner of the ResultExpressionMembership." ;
    rdfs:domain :ResultExpressionMembership ;
    rdfs:range :Expression ;
    rdfs:subPropertyOf :FeatureMembership_ownedMemberFeature ;
    a owl:FunctionalProperty .

:Specialization_owningType
    a owl:ObjectProperty ;
    rdfs:label "owningType" ;
    rdfs:comment "The Type that is the specific Type of this Specialization and owns it as its owningRelatedElement." ;
    rdfs:domain :Specialization ;
    rdfs:range :Type ;
    rdfs:subPropertyOf :Relationship_owningRelatedElement ;
    rdfs:subPropertyOf :Specialization_specific ;
    a owl:FunctionalProperty .

:StakeholderMembership_ownedStakeholderParameter
    a owl:ObjectProperty ;
    rdfs:label "ownedStakeholderParameter" ;
    rdfs:comment "The PartUsage specifying the stakeholder." ;
    rdfs:domain :StakeholderMembership ;
    rdfs:range :PartUsage ;
    rdfs:subPropertyOf :ParameterMembership_ownedMemberParameter ;
    a owl:FunctionalProperty .

:Subclassification_owningClassifier
    a owl:ObjectProperty ;
    rdfs:label "owningClassifier" ;
    rdfs:comment "The Classifier that owns this Subclassification relationship, which must also be its subclassifier." ;
    rdfs:domain :Subclassification ;
    rdfs:range :Classifier ;
    rdfs:subPropertyOf :Specialization_owningType ;
    a owl:FunctionalProperty .

:SubjectMembership_ownedSubjectParameter
    a owl:ObjectProperty ;
    rdfs:label "ownedSubjectParameter" ;
    rdfs:comment "The UsageownedMemberParameter of this SubjectMembership." ;
    rdfs:domain :SubjectMembership ;
    rdfs:range :Usage ;
    rdfs:subPropertyOf :ParameterMembership_ownedMemberParameter ;
    a owl:FunctionalProperty .

:Subsetting_owningFeature
    a owl:ObjectProperty ;
    rdfs:label "owningFeature" ;
    rdfs:comment "A subsettingFeature that is also the owningRelatedElement of this Subsetting." ;
    rdfs:domain :Subsetting ;
    rdfs:range :Feature ;
    rdfs:subPropertyOf :Specialization_owningType ;
    rdfs:subPropertyOf :Subsetting_subsettingFeature ;
    a owl:FunctionalProperty .

:TypeFeaturing_owningFeatureOfType
    a owl:ObjectProperty ;
    rdfs:label "owningFeatureOfType" ;
    rdfs:comment "A featureOfType that is also the owningRelatedElement of this TypeFeaturing." ;
    rdfs:domain :TypeFeaturing ;
    rdfs:range :Feature ;
    rdfs:subPropertyOf :Relationship_owningRelatedElement ;
    rdfs:subPropertyOf :TypeFeaturing_featureOfType ;
    a owl:FunctionalProperty .

:Type_ownedConjugator
    a owl:ObjectProperty ;
    rdfs:label "ownedConjugator" ;
    rdfs:comment "A Conjugation owned by this Type for which the Type is the originalType." ;
    rdfs:domain :Type ;
    rdfs:range :Conjugation ;
    owl:inverseOf :Conjugation_owningType ;
    a owl:FunctionalProperty .

:Type_ownedDifferencing
    a owl:ObjectProperty ;
    rdfs:label "ownedDifferencing" ;
    rdfs:comment "The ownedRelationships of this Type that are Differencings, having this Type as their typeDifferenced." ;
    rdfs:domain :Type ;
    rdfs:range :Differencing ;
    owl:inverseOf :Differencing_typeDifferenced ;
    a owl:FunctionalProperty .

:Type_ownedDisjoining
    a owl:ObjectProperty ;
    rdfs:label "ownedDisjoining" ;
    rdfs:comment "The ownedRelationships of this Type that are Disjoinings, for which the Type is the typeDisjoined Type." ;
    rdfs:domain :Type ;
    rdfs:range :Disjoining ;
    owl:inverseOf :Disjoining_owningType ;
    a owl:FunctionalProperty .

:Type_ownedEndFeature
    a owl:ObjectProperty ;
    rdfs:label "ownedEndFeature" ;
    rdfs:comment "All endFeatures of this Type that are ownedFeatures." ;
    rdfs:domain :Type ;
    rdfs:range :Feature ;
    rdfs:subPropertyOf :Type_endFeature ;
    rdfs:subPropertyOf :Type_ownedFeature .

:Type_ownedFeature
    a owl:ObjectProperty ;
    rdfs:label "ownedFeature" ;
    rdfs:comment "The ownedMemberFeatures of the ownedFeatureMemberships of this Type." ;
    rdfs:domain :Type ;
    rdfs:range :Feature ;
    rdfs:subPropertyOf :Namespace_ownedMember .

:Type_ownedFeatureMembership
    a owl:ObjectProperty ;
    rdfs:label "ownedFeatureMembership" ;
    rdfs:comment "The ownedMemberships of this Type that are FeatureMemberships, for which the Type is the owningType. Each such FeatureMembership identifies an ownedFeature of the Type." ;
    rdfs:domain :Type ;
    rdfs:range :FeatureMembership ;
    rdfs:subPropertyOf :Type_featureMembership ;
    owl:inverseOf :FeatureMembership_owningType ;
    a owl:FunctionalProperty .

:Type_ownedIntersecting
    a owl:ObjectProperty ;
    rdfs:label "ownedIntersecting" ;
    rdfs:comment "The ownedRelationships of this Type that are Intersectings, have the Type as their typeIntersected." ;
    rdfs:domain :Type ;
    rdfs:range :Intersecting ;
    owl:inverseOf :Intersecting_typeIntersected ;
    a owl:FunctionalProperty .

:Type_ownedSpecialization
    a owl:ObjectProperty ;
    rdfs:label "ownedSpecialization" ;
    rdfs:comment "The ownedRelationships of this Type that are Specializations, for which the Type is the specific Type." ;
    rdfs:domain :Type ;
    rdfs:range :Specialization ;
    owl:inverseOf :Specialization_owningType ;
    a owl:FunctionalProperty .

:Type_ownedUnioning
    a owl:ObjectProperty ;
    rdfs:label "ownedUnioning" ;
    rdfs:comment "The ownedRelationships of this Type that are Unionings, having the Type as their typeUnioned." ;
    rdfs:domain :Type ;
    rdfs:range :Unioning ;
    owl:inverseOf :Unioning_typeUnioned ;
    a owl:FunctionalProperty .

:Usage_owningDefinition
    a owl:ObjectProperty ;
    rdfs:label "owningDefinition" ;
    rdfs:comment "The Definition that owns this Usage (if any)." ;
    rdfs:domain :Usage ;
    rdfs:range :Definition ;
    owl:inverseOf :Definition_ownedUsage .

:Usage_owningUsage
    a owl:ObjectProperty ;
    rdfs:label "owningUsage" ;
    rdfs:comment "The Usage in which this Usage is nested (if any)." ;
    rdfs:domain :Usage ;
    rdfs:range :Usage ;
    owl:inverseOf :Usage_nestedUsage .

:VariantMembership_ownedVariantUsage
    a owl:ObjectProperty ;
    rdfs:label "ownedVariantUsage" ;
    rdfs:comment "The Usage that represents a variant in the context of the owningVariationDefinition or owningVariationUsage." ;
    rdfs:domain :VariantMembership ;
    rdfs:range :Usage ;
    rdfs:subPropertyOf :OwningMembership_ownedMemberElement ;
    a owl:FunctionalProperty .

:ViewRenderingMembership_ownedRendering
    a owl:ObjectProperty ;
    rdfs:label "ownedRendering" ;
    rdfs:comment "The owned RenderingUsage that is either itself the referencedRendering or subsets the referencedRendering." ;
    rdfs:domain :ViewRenderingMembership ;
    rdfs:range :RenderingUsage ;
    rdfs:subPropertyOf :FeatureMembership_ownedMemberFeature ;
    a owl:FunctionalProperty .

