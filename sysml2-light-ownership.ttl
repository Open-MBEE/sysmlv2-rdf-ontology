    rdfs:label "ownedAnnotatingRelationship" ;
    rdfs:comment "The ownedRelationships of this AnnotatingElement that are Annotations, for which this AnnotatingElement is the annotatingElement." ;
    rdfs:domain :AnnotatingElement ;
    rdfs:range :Annotation ;
    owl:inverseOf :Annotation_owningAnnotatingElement ;
    a owl:FunctionalProperty .

:Annotation_owningAnnotatedElement
    a owl:ObjectProperty ;
    rdfs:label "owningAnnotatedElement" ;
    rdfs:comment "The annotatedElement of this Annotation, when it is also its owningRelatedElement." ;
    rdfs:domain :Annotation ;
    rdfs:range :Element ;
    rdfs:subPropertyOf :Annotation_annotatedElement ;
    rdfs:subPropertyOf :Relationship_owningRelatedElement ;
    a owl:FunctionalProperty .

:Annotation_owningAnnotatingElement
    a owl:ObjectProperty ;
    rdfs:label "owningAnnotatingElement" ;
    rdfs:comment "The annotatingElement of this Annotation, when it is also its owningRelatedElement." ;
    rdfs:domain :Annotation ;
    rdfs:range :AnnotatingElement ;
    rdfs:subPropertyOf :Annotation_annotatingElement ;
    rdfs:subPropertyOf :Relationship_owningRelatedElement ;
    a owl:FunctionalProperty .

